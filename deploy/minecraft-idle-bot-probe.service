[Unit]
Description=Minecraft idle bot network probe
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/huoyuuu/services/minecraft-idle-bot
EnvironmentFile=/home/huoyuuu/services/minecraft-idle-bot/.env
Environment=NODE_OPTIONS=--max-old-space-size=48
ExecStart=/home/huoyuuu/services/minecraft-idle-bot/.runtime/bin/node probe/server.js
Restart=always
RestartSec=10
Nice=5
MemoryHigh=64M
MemoryMax=96M
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
